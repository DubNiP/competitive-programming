#include <bits/stdc++.h>
using namespace std;
#DEFINE ll long long

ll n,m,k,mid,resp=0;
ll mat[20][20];
map<ll,ll> mapa[20][20];

void searchBGN(int x, int y, ll xor){
    xor^=mat[x][y];
    if(x+y==mid) mapa[x][y][xor]++;
    if(x+1<n) searchBGN(x+1,y,xor);
    if(y+1<m) searchBGN(x,y+1,xor);
}

void searchEND(int x, int y, ll xor,ll cont){
    if(cont==n+m-2-mid){
        if(mapa[x][y].count(xor)) resp+=mapa[x][y][xor];
        return;
    }
    xor^=mat[x][y];
    if(x>0) searchEND(x-1,y,xor,cont+1);
    if(y>0) searchEND(x,y-1,xor,cont+1);
}


void solve(){
    cin>>n>>m>>k;
    mid=(n+m-2)/2;
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>mat[i][j];
        }
    }
    searchBGN(0,0,0);
    searchEND(n-1,m-1,0,0);
    cout<<resp<<"\n";
}

int main(){
    ios_base::sync_with_stdio(0);cin.tie(0);
    solve();
}
    
